{"language":"en","model":"mlx-community/whisper-large-v3-turbo", "segments": [
  {"start":0,"end":4.44,"text":"Good morning everyone. This is the product planning meeting for the mobile app relaunch.","words":[[0,0.14," Good"],[0.14,0.44," morning"],[0.44,0.9," everyone."],[1.28,1.62," This"],[1.62,1.76," is"],[1.76,1.9," the"],[1.9,2.24," product"],[2.24,2.64," planning"],[2.64,2.96," meeting"],[2.96,3.2," for"],[3.2,3.32," the"],[3.32,3.62," mobile"],[3.62,3.9," app"],[3.9,4.44," relaunch."]]},
  {"start":4.64,"end":10.2,"text":"We have three topics today, the onboarding redesign, the payment provider, and the launch date.","words":[[4.64,4.86," We"],[4.86,5.06," have"],[5.06,5.24," three"],[5.24,5.74," topics"],[5.74,6.14," today,"],[6.38,6.6," the"],[6.6,7.16," onboarding"],[7.16,7.52," redesign,"],[8,8.18," the"],[8.18,8.52," payment"],[8.52,9.08," provider,"],[9.28,9.5," and"],[9.5,9.62," the"],[9.62,9.88," launch"],[9.88,10.2," date."]]},
  {"start":10.86,"end":12.48,"text":"Let's start with onboarding.","words":[[10.86,11.46," Let's"],[11.46,11.74," start"],[11.74,11.94," with"],[11.94,12.48," onboarding."]]},
  {"start":12.68,"end":17.72,"text":"The current flow has seven screens and we lose about 40% of users before they finish.","words":[[12.68,12.9," The"],[12.9,13.24," current"],[13.24,13.54," flow"],[13.54,13.8," has"],[13.8,14.12," seven"],[14.12,14.56," screens"],[14.56,14.76," and"],[14.76,14.92," we"],[14.92,15.16," lose"],[15.16,15.44," about"],[15.44,15.84," 40"],[15.84,16.14,"%"],[16.14,16.5," of"],[16.5,16.82," users"],[16.82,17.12," before"],[17.12,17.32," they"],[17.32,17.72," finish."]]},
  {"start":18.24,"end":21.74,"text":"I tested a shorter version with three screens last week.","words":[[18.24,18.84," I"],[18.84,19.24," tested"],[19.24,19.46," a"],[19.46,19.68," shorter"],[19.68,20.06," version"],[20.06,20.28," with"],[20.28,20.5," three"],[20.5,20.96," screens"],[20.96,21.28," last"],[21.28,21.74," week."]]},
  {"start":22.06,"end":25.54,"text":"Completion went from 60 to 82% in the prototype.","words":[[22.06,22.66," Completion"],[22.66,22.88," went"],[22.88,23.1," from"],[23.1,23.54," 60"],[23.54,23.72," to"],[23.72,24.18," 82"],[24.18,24.6,"%"],[24.6,24.9," in"],[24.9,25," the"],[25,25.54," prototype."]]},
  {"start":26.28,"end":27.62,"text":"That's a big improvement.","words":[[26.28,26.88," That's"],[26.88,26.98," a"],[26.98,27.16," big"],[27.16,27.62," improvement."]]},
  {"start":27.96,"end":30.66,"text":"So do we agree to ship the three screen onboarding?","words":[[27.96,28.22," So"],[28.22,28.42," do"],[28.42,28.62," we"],[28.62,28.88," agree"],[28.88,29.08," to"],[29.08,29.32," ship"],[29.32,29.5," the"],[29.5,29.7," three"],[29.7,30," screen"],[30,30.66," onboarding?"]]},
  {"start":31.36,"end":34.8,"text":"Yes, I agree. Let's go with three screens.","words":[[31.36,31.96," Yes,"],[32.18,32.4," I"],[32.4,32.74," agree."],[33.12,33.56," Let's"],[33.56,33.72," go"],[33.72,33.94," with"],[33.94,34.18," three"],[34.18,34.8," screens."]]},
  {"start":35.78,"end":40.14,"text":"Agreed. I will finish the final designs by Thursday and share them with engineering.","words":[[35.78,36.28," Agreed."],[36.58,36.66," I"],[36.66,36.82," will"],[36.82,37.14," finish"],[37.14,37.34," the"],[37.34,37.66," final"],[37.66,38.12," designs"],[38.12,38.38," by"],[38.38,38.76," Thursday"],[38.76,39.06," and"],[39.06,39.3," share"],[39.3,39.46," them"],[39.46,39.66," with"],[39.66,40.14," engineering."]]},
  {"start":41.16,"end":43.88,"text":"Great. Next topic, the payment provider.","words":[[41.16,41.52," Great."],[41.76,42.12," Next"],[42.12,42.52," topic,"],[42.78,43," the"],[43,43.34," payment"],[43.34,43.88," provider."]]},
  {"start":44.16,"end":46.26,"text":"We are choosing between Stripe and Adyen.","words":[[44.16,44.36," We"],[44.36,44.52," are"],[44.52,44.9," choosing"],[44.9,45.24," between"],[45.24,45.8," Stripe"],[45.8,45.94," and"],[45.94,46.26," Adyen."]]},
  {"start":46.86,"end":51.94,"text":"Adyen has lower fees for Brazil, but the integration would take about three more weeks.","words":[[46.86,47.46," Adyen"],[47.46,47.72," has"],[47.72,47.96," lower"],[47.96,48.3," fees"],[48.3,48.48," for"],[48.48,48.92," Brazil,"],[49.22,49.44," but"],[49.44,49.6," the"],[49.6,50.12," integration"],[50.12,50.44," would"],[50.44,50.68," take"],[50.68,50.98," about"],[50.98,51.26," three"],[51.26,51.5," more"],[51.5,51.94," weeks."]]},
  {"start":52.26,"end":54.24,"text":"Stripe we could integrate in one week.","words":[[52.26,52.68," Stripe"],[52.68,52.82," we"],[52.82,53.02," could"],[53.02,53.42," integrate"],[53.42,53.66," in"],[53.66,53.88," one"],[53.88,54.24," week."]]},
  {"start":54.24,"end":57.06,"text":"I am worried about the fees long term.","words":[[54.24,55.28," I"],[55.28,55.46," am"],[55.46,55.8," worried"],[55.8,56.02," about"],[56.02,56.2," the"],[56.2,56.48," fees"],[56.48,56.72," long"],[56.72,57.06," term."]]},
  {"start":57.38,"end":60.1,"text":"Brazil is going to be our biggest market next year.","words":[[57.38,57.7," Brazil"],[57.7,57.94," is"],[57.94,58.2," going"],[58.2,58.36," to"],[58.36,58.5," be"],[58.5,58.66," our"],[58.66,58.96," biggest"],[58.96,59.42," market"],[59.42,59.72," next"],[59.72,60.1," year."]]},
  {"start":60.64,"end":62.94,"text":"I don't think we can decide this today.","words":[[60.64,61.1," I"],[61.1,61.36," don't"],[61.36,61.58," think"],[61.58,61.76," we"],[61.76,61.94," can"],[61.94,62.32," decide"],[62.32,62.56," this"],[62.56,62.94," today."]]},
  {"start":63.22,"end":68.74,"text":"Daniel, can you prepare a cost comparison for 12 months, including the engineering time?","words":[[63.22,63.62," Daniel,"],[63.92,64.14," can"],[64.14,64.3," you"],[64.3,64.68," prepare"],[64.68,64.88," a"],[64.88,65.16," cost"],[65.16,65.68," comparison"],[65.68,66.04," for"],[66.04,66.3," 12"],[66.3,66.86," months,"],[67.1,67.56," including"],[67.56,67.8," the"],[67.8,68.24," engineering"],[68.24,68.74," time?"]]},
  {"start":69.46,"end":72.98,"text":"Sure. I will have the comparison ready by next Monday.","words":[[69.46,70.06," Sure."],[70.36,70.58," I"],[70.58,70.76," will"],[70.76,70.94," have"],[70.94,71.06," the"],[71.06,71.62," comparison"],[71.62,71.98," ready"],[71.98,72.22," by"],[72.22,72.58," next"],[72.58,72.98," Monday."]]},
  {"start":73.92,"end":75.74,"text":"Last topic, the launch date.","words":[[73.92,74.26," Last"],[74.26,74.66," topic,"],[74.94,75.12," the"],[75.12,75.38," launch"],[75.38,75.74," date."]]},
  {"start":76.04,"end":77.86,"text":"Marketing wants March 15th.","words":[[76.04,76.44," Marketing"],[76.44,76.78," wants"],[76.78,77.1," March"],[77.1,77.86," 15th."]]},
  {"start":78.4,"end":81.08,"text":"March 15th is risky if we pick Adyen.","words":[[78.4,79," March"],[79,79.6," 15th"],[79.6,79.74," is"],[79.74,80.08," risky"],[80.08,80.3," if"],[80.3,80.44," we"],[80.44,80.7," pick"],[80.7,80.82," a"],[80.82,81.08," Dian."]]},
  {"start":81.26,"end":83.38,"text":"We would have almost no buffer for testing.","words":[[81.26,81.52," We"],[81.52,81.68," would"],[81.68,81.8," have"],[81.8,82.2," almost"],[82.2,82.46," no"],[82.46,82.76," buffer"],[82.76,82.96," for"],[82.96,83.38," testing."]]},
  {"start":84.24,"end":86.84,"text":"Then the launch date depends on the payment decision.","words":[[84.24,84.52," Then"],[84.52,84.68," the"],[84.68,85.02," launch"],[85.02,85.28," date"],[85.28,85.64," depends"],[85.64,85.92," on"],[85.92,86.04," the"],[86.04,86.34," payment"],[86.34,86.84," decision."]]},
  {"start":87.28,"end":89.62,"text":"Let's not commit to March 15th yet.","words":[[87.28,87.66," Let's"],[87.66,87.86," not"],[87.86,88.18," commit"],[88.18,88.34," to"],[88.34,88.64," March"],[88.64,89.26," 15th"],[89.26,89.62," yet."]]},
